# ============================================================================
# pharma-leaflet-compliance-agent — configuration template
# Copy to `.env` and fill in. `.env` is in .gitignore: do NOT commit it.
# ============================================================================

# ---- Credentials (required) -------------------------------------------------
OPENAI_API_KEY=sk-...

# ---- Model per agent -------------------------------------------------------
# Step 1: rule generation from the dispositions (2 passes)
RULES_GENERATOR_MODEL=gpt-4.1
RULES_GENERATOR_TEMPERATURE=0.0

# Step 3a: classifier (which dispositions apply to the leaflet?)
CLASSIFIER_MODEL=gpt-4.1-mini
CLASSIFIER_TEMPERATURE=0.01
# CLASSIFIER_TOP_P=1.0
# Seconds to wait between calls (0 = no wait; the SDK already retries 429s)
CLASSIFIER_DELAY_SECONDS=0

# Step 3b: checker (is each rule met?)
CHECKER_MODEL=gpt-4.1-mini
CHECKER_TEMPERATURE=0.01
# CHECKER_TOP_P=1.0
# CHECKER_MAX_COMPLETION_TOKENS=4096
CHECKER_DELAY_SECONDS=0

# Step 4: one-shot adequator
ADEQUATOR_ONESHOT_MODEL=gpt-4.1
ADEQUATOR_ONESHOT_TEMPERATURE=0.2
ADEQUATOR_ONESHOT_TOP_P=1.0

# ---- Retries ---------------------------------------------------------------
# Layer 1 (SDK): automatic retries with backoff on 429s / transport errors
MAX_RETRIES=5
# Layer 2 (pipeline): attempts per classification and per rule when the response
# arrives but is unusable (does not parse as JSON, comes back truncated). Once
# they run out the run fails: the pipeline never accepts partial analyses.
LLM_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=1.0

# ---- Step 5: final verification with Claude (optional) ---------------------
# Reviews step 4's adequation with a model from another provider and flags which
# rules need human judgement. Without this credential the step stays off.
ANTHROPIC_API_KEY=
# claude-haiku-4-5 is the cheapest; claude-opus-5 the most capable (and ~10x pricier)
VERIFIER_MODEL=claude-haiku-4-5
# Only the 5/4.6+ models use it: low | medium | high | xhigh | max
VERIFIER_EFFORT=high
VERIFIER_MAX_TOKENS=64000

# ---- Emailing the results (optional) ---------------------------------------
# If whoever launches the run leaves an address in the web's first screen, the
# run ends by mailing them the adequated leaflet (DOCX) and the compliance
# report (PDF). Without SMTP_HOST/SMTP_FROM nothing is sent and the run just
# says so: the artifacts are on disk either way.
#
# Gmail requires an APP PASSWORD (Google Account → Security → 2-Step
# Verification → App passwords), never the account's own password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# Bare address, or "Name <address>". Defaults to SMTP_USER.
SMTP_FROM=
# Port 465 uses implicit TLS; 587 negotiates STARTTLS (the default).
# SMTP_STARTTLS=1
# SMTP_TIMEOUT_SECONDS=30

# ---- Local OCR (only for PDFs without a text layer) ------------------------
# Path to the locally downloaded DeepSeek-OCR model
OCR_MODEL_DIR=~/modelos/DeepSeek-OCR
# Inference device: mps (Apple Silicon) | cuda | cpu
OCR_DEVICE=mps
OCR_DPI=300
OCR_TARGET_HEIGHT=2048

# ---- Directories (optional; relative to the repo root by default) ----------
# "Factory" rules used when answering that rules ALREADY exist
BASE_RULES_DIR=disposiciones/disposiciones-originales/reglas-base
# Source dispositions step 1 extracts the rules from
DISPOSITIONS_SOURCES_DIR=disposiciones/disposiciones-originales/fuentes
# Root of the rules generated by step 1
DISPOSICIONES_EXPLOTADAS_DIR=disposiciones/disposiciones-explotadas
# Root of the runs (steps 2 to 4)
CORRIDAS_DIR=corridas

# ---- Deployment (optional; only used by scripts/deploy.sh) -----------------
# DEPLOY_HOST=my-server.example.com
# DEPLOY_USER=my-user
# DEPLOY_PORT=22
# DEPLOY_REMOTE_DIR=~/pharma-leaflet-compliance-agent
# DEPLOY_DRY_RUN=1
