# ============================================================================
# Datos del servidor para los scripts de scripts/ (deploy y conexión SSH).
#
#   cp scripts/.env.example scripts/.env   y completá los valores
#
# `scripts/.env` está en .gitignore: nada de esto se sube al repositorio.
# ============================================================================

# ---- Obligatorios ----------------------------------------------------------
# Host o IP del servidor
VPS_HOST=
# Usuario SSH
VPS_USER=

# ---- Opcionales ------------------------------------------------------------
# Puerto SSH (default: 22)
VPS_PORT=
# Carpeta remota del proyecto, relativa al home del usuario
# (default: pharma-leaflet-compliance-agent)
VPS_DIR=
# Puerto donde queda escuchando la web (default: 8000)
VPS_WEB_PORT=

# Contraseña SSH. Sólo hace falta si NO usás clave pública, y para que el deploy
# sea desatendido necesita sshpass instalado (brew install hudochenkov/sshpass/sshpass).
# Lo recomendable es dejarla vacía y copiar tu clave una vez:
#     ssh-copy-id -p <puerto> <usuario>@<host>
VPS_PASSWORD=
